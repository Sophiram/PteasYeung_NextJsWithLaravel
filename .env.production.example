# ==============================================================================
# Pteas Yeung Platform - Production Environment Configuration Template
# Copy this file to .env on your production server: cp .env.production.example .env
# ==============================================================================

# Server HTTP Port (Default: 80)
PORT_HTTP=80

# Frontend Public URLs
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_STORAGE_URL=/storage

# Laravel App Configuration
APP_NAME="Pteas Yeung Platform"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Database (PostgreSQL 16)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pteas_yeung
DB_USERNAME=pteas_user
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# Cache & Session & Queue (Redis)
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PORT=6379

# Email / Mailer (Optional)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Object Storage (MinIO S3 - Container: room-minio)
FILESYSTEM_DISK=minio
MINIO_KEY=minioadmin
MINIO_SECRET=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET=pteas-yeung
MINIO_ENDPOINT=http://room-minio:9000
MINIO_URL=http://localhost:9000/pteas-yeung
MINIO_USE_PATH_STYLE_ENDPOINT=true
